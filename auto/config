#!/bin/sh
# ============================================================
#  NexOS — live-build auto/config
#  Invoked by lb config automatically.
#  All build parameters centralized here for reproducibility.
# ============================================================

set -e

lb config noauto \
    --architectures amd64 \
    --distribution trixie \
    --archive-areas "main contrib non-free non-free-firmware" \
    --linux-packages "linux-image" \
    --linux-flavours amd64 \
    --binary-images iso-hybrid \
    --bootloaders "syslinux,grub-efi" \
    --apt-recommends true \
    --memtest none \
    --source false \
    --security true \
    --updates true \
    --backports true \
    --compression xz \
    --firmware-binary true \
    --firmware-chroot true \
    --initramfs live-boot \
    --debootstrap-options "--include=apt-transport-https,ca-certificates,openssl" \
    --iso-volume "NexOS" \
    --iso-publisher "NexOS Project; https://github.com/jpscalero/NexOS" \
    --iso-application "NexOS Live" \
    --bootappend-live "boot=live components quiet splash hostname=nexos username=nexos locales=es_ES.UTF-8 keyboard-layouts=es user-default-groups=audio,cdrom,dip,floppy,video,plugdev,netdev,sudo,wireshark,bluetooth,docker" \
    "${@}"
