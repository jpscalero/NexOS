#!/bin/bash
# ============================================================
#  NexOS — Advanced Hardening Hook
#  config/hooks/live/09-advanced-hardening.chroot
#  Zsh, Flatpak, kernel hardening, Firefox privacy, cron jobs
# ============================================================
set -e

echo "[NexOS] Aplicando hardening avanzado..."

# ── 1. Set Zsh as Default Shell for New Users ─────────────
if command -v zsh &>/dev/null; then
    sed -i 's|DSHELL=/bin/bash|DSHELL=/usr/bin/zsh|' /etc/adduser.conf 2>/dev/null || true
    echo "[NexOS] ✅ Zsh como shell por defecto para nuevos usuarios."
fi

# ── 2. Configure Flatpak with Flathub ─────────────────────
if command -v flatpak &>/dev/null; then
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
    echo "[NexOS] ✅ Flathub repository añadido."
fi

# ── 3. Harden login.defs ─────────────────────────────────
if [ -f /etc/login.defs ]; then
    # Password aging policies
    sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS   90/' /etc/login.defs
    sed -i 's/^PASS_MIN_DAYS.*/PASS_MIN_DAYS   7/' /etc/login.defs
    sed -i 's/^PASS_WARN_AGE.*/PASS_WARN_AGE   14/' /etc/login.defs
    sed -i 's/^PASS_MIN_LEN.*/PASS_MIN_LEN    12/' /etc/login.defs

    # Restrict su to sudo group
    sed -i 's/^# auth.*pam_wheel.so/auth       required   pam_wheel.so/' /etc/pam.d/su 2>/dev/null || true

    # Umask
    sed -i 's/^UMASK.*/UMASK           027/' /etc/login.defs
    echo "[NexOS] ✅ Políticas de contraseñas y login endurecidas."
fi

# ── 4. Restrict Compiler Access ──────────────────────────
if command -v gcc &>/dev/null; then
    chmod o-rx /usr/bin/gcc* 2>/dev/null || true
    chmod o-rx /usr/bin/g++* 2>/dev/null || true
    chmod o-rx /usr/bin/make 2>/dev/null || true
    echo "[NexOS] ✅ Acceso a compiladores restringido."
fi

# ── 5. Firefox Privacy Configuration ─────────────────────
echo "[NexOS] Configurando Firefox ESR con hardening de privacidad..."
mkdir -p /etc/firefox-esr
mkdir -p /usr/lib/firefox-esr/defaults/pref

cat > /usr/lib/firefox-esr/defaults/pref/autoconfig.js << 'AUTOCONF'
pref("general.config.filename", "nexos.cfg");
pref("general.config.obscure_value", 0);
AUTOCONF

cat > /usr/lib/firefox-esr/nexos.cfg << 'FFCFG'
// NexOS Firefox Privacy Config Loader
try {
    let file = Components.classes["@mozilla.org/file/local;1"].createInstance(Components.interfaces.nsIFile);
    file.initWithPath("/etc/firefox-esr/nexos.js");
} catch(e) {}
FFCFG

cat > /etc/firefox-esr/nexos.js << 'NEXOSJS'
// NexOS Firefox Privacy Preferences
// Anti-tracking
pref("privacy.trackingprotection.enabled", true);
pref("privacy.trackingprotection.socialtracking.enabled", true);
pref("privacy.trackingprotection.cryptomining.enabled", true);
pref("privacy.trackingprotection.fingerprinting.enabled", true);
pref("browser.contentblocking.category", "strict");

// DNS-over-HTTPS (disabled - we use system-level dnscrypt-proxy)
pref("network.trr.mode", 0);

// Disable telemetry
pref("toolkit.telemetry.enabled", false);
pref("toolkit.telemetry.unified", false);
pref("toolkit.telemetry.archive.enabled", false);
pref("datareporting.healthreport.uploadEnabled", false);
pref("datareporting.policy.dataSubmissionEnabled", false);
pref("browser.ping-centre.telemetry", false);

// Disable Pocket
pref("extensions.pocket.enabled", false);

// Disable form autofill
pref("extensions.formautofill.addresses.enabled", false);
pref("extensions.formautofill.creditCards.enabled", false);

// Disable WebRTC IP leak
pref("media.peerconnection.enabled", false);
pref("media.peerconnection.ice.default_address_only", true);

// HTTPS-Only Mode
pref("dom.security.https_only_mode", true);
pref("dom.security.https_only_mode_ever_enabled", true);

// Disable prefetching
pref("network.dns.disablePrefetch", true);
pref("network.prefetch-next", false);
pref("network.http.speculative-parallel-limit", 0);

// Disable third-party cookies
pref("network.cookie.cookieBehavior", 1);

// Clear on shutdown
pref("privacy.sanitize.sanitizeOnShutdown", false);
pref("privacy.clearOnShutdown.cookies", false);
pref("privacy.clearOnShutdown.history", false);

// Disable sponsored content
pref("browser.newtabpage.activity-stream.showSponsored", false);
pref("browser.newtabpage.activity-stream.showSponsoredTopSites", false);

// Homepage
pref("browser.startup.homepage", "about:home");
NEXOSJS
echo "[NexOS] ✅ Firefox ESR hardenizado."

# ── 6. Harden /tmp and /proc in fstab ────────────────────
echo "tmpfs /tmp tmpfs defaults,noexec,nosuid,nodev 0 0" >> /etc/fstab
echo "proc /proc proc defaults,hidepid=2 0 0" >> /etc/fstab
echo "[NexOS] ✅ /tmp noexec y /proc hidepid configurados."

# ── 7. AIDE Cron (Intrusion Detection) ───────────────────
cat > /etc/cron.daily/aide-check << 'AIDE_CRON'
#!/bin/bash
/usr/bin/aide --check --config=/etc/aide/aide.conf | mail -s "AIDE Report - $(hostname)" root 2>/dev/null || true
AIDE_CRON
chmod +x /etc/cron.daily/aide-check

# ── 8. ClamAV Daily Scan ─────────────────────────────────
cat > /etc/cron.daily/clamav-scan << 'CLAM_CRON'
#!/bin/bash
LOGFILE="/var/log/clamav/daily-scan.log"
echo "ClamAV Daily Scan - $(date)" > "$LOGFILE"
clamscan -r --infected --exclude-dir="^/sys" --exclude-dir="^/proc" --exclude-dir="^/dev" /home /tmp /var/tmp >> "$LOGFILE" 2>&1
CLAM_CRON
chmod +x /etc/cron.daily/clamav-scan
mkdir -p /var/log/clamav

# ── 9. NexOS Daily Health Check ──────────────────────────
cat > /etc/cron.daily/nexos-healthcheck << 'HEALTHCHECK'
#!/bin/bash
LOG="/var/log/nexos/healthcheck-$(date +%Y%m%d).log"
mkdir -p /var/log/nexos
{
    echo "=== NexOS Health Check - $(date) ==="
    echo ""
    echo "--- Disk Usage ---"
    df -h / /home 2>/dev/null
    echo ""
    echo "--- Memory ---"
    free -h
    echo ""
    echo "--- Failed Services ---"
    systemctl --failed 2>/dev/null
    echo ""
    echo "--- Security Updates ---"
    apt list --upgradable 2>/dev/null | head -20
    echo ""
    echo "--- Failed SSH Logins (last 24h) ---"
    journalctl -u ssh --since "24 hours ago" 2>/dev/null | grep -i "failed" | wc -l
    echo ""
    echo "--- UFW Blocked (last 24h) ---"
    journalctl --since "24 hours ago" 2>/dev/null | grep -i "UFW BLOCK" | wc -l
} > "$LOG" 2>&1

# Keep only last 30 days
find /var/log/nexos -name "healthcheck-*.log" -mtime +30 -delete 2>/dev/null || true
HEALTHCHECK
chmod +x /etc/cron.daily/nexos-healthcheck
mkdir -p /var/log/nexos

# ── 10. Suricata Default Config ──────────────────────────
mkdir -p /etc/suricata
cat > /etc/default/suricata << 'SURICATA_DEFAULT'
# NexOS Suricata IDS defaults
RUN=yes
SURCONF=/etc/suricata/suricata.yaml
LISTENMODE=af-packet
IFACE=eth0
SURICATA_DEFAULT

# ── 11. Configure journald ───────────────────────────────
mkdir -p /etc/systemd/journald.conf.d/
cat > /etc/systemd/journald.conf.d/nexos.conf << 'JOURNALD'
[Journal]
Storage=persistent
Compress=yes
SystemMaxUse=500M
SystemKeepFree=1G
MaxRetentionSec=3month
ForwardToSyslog=yes
JOURNALD

# ── 12. Legal Notice ─────────────────────────────────────
cat > /etc/issue << 'ISSUE'
╔═══════════════════════════════════════════╗
║         ⚡  NexOS Vanguard  ⚡            ║
║   Unauthorized access is prohibited.      ║
║   All activity is monitored and logged.   ║
╚═══════════════════════════════════════════╝

ISSUE

cat > /etc/issue.net << 'ISSUENET'
NexOS Vanguard - Unauthorized access is prohibited. All activity is monitored.
ISSUENET

# ── 13. MOTD Dynamic ─────────────────────────────────────
echo "" > /etc/motd
mkdir -p /etc/update-motd.d
cat > /etc/update-motd.d/10-nexos-status << 'MOTD'
#!/bin/bash
echo ""
echo -e "\e[1;34m  _   _             ____  ____  \e[0m"
echo -e "\e[1;34m | \ | | _____  __/ __ \/ ___| \e[0m"
echo -e "\e[1;34m |  \| |/ _ \ \/ / |  | \___ \ \e[0m"
echo -e "\e[1;34m | |\  |  __/>  <| |__| |___) |\e[0m"
echo -e "\e[1;34m |_| \_|\___/_/\_\\____/|____/ \e[0m"
echo -e "\e[1;36m      Vanguard Edition\e[0m"
echo ""
echo -e "\e[0;37m  Kernel:   $(uname -r)\e[0m"
echo -e "\e[0;37m  Uptime:   $(uptime -p 2>/dev/null || uptime)\e[0m"
echo -e "\e[0;37m  IP:       $(hostname -I 2>/dev/null | awk '{print $1}')\e[0m"
echo -e "\e[0;37m  Firewall: $(ufw status 2>/dev/null | head -1 || echo 'N/A')\e[0m"
echo ""
echo -e "\e[1;33m  Comandos: nexos-harden | nexos-clean | nexos-netmon\e[0m"
echo ""
MOTD
chmod +x /etc/update-motd.d/10-nexos-status

# ── 14. Syslog Hardening ─────────────────────────────────
chmod -R g-rwx,o-rwx /var/log/ 2>/dev/null || true

# ── 15. Restrict sensitive file permissions ───────────────
chmod 600 /etc/ssh/sshd_config.d/nexos.conf 2>/dev/null || true
chmod 600 /etc/fail2ban/jail.local 2>/dev/null || true
chmod 600 /etc/usbguard/rules.conf 2>/dev/null || true

# ── 16. Vim as sensible default ───────────────────────────
update-alternatives --set editor /usr/bin/vim.basic 2>/dev/null || true

echo "[NexOS] ✅ Hardening avanzado completado."
