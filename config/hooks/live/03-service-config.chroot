#!/bin/bash
# ============================================================
#  NexOS — Service Configuration Hook
#  config/hooks/live/03-service-config.chroot
#  Configura servicios, SSH, UFW, symlinks CLI
# ============================================================
set -e

echo "[NexOS] Configurando servicios..."

# ── 1. Enable Security Services ───────────────────────────
WANTS_DIR="/etc/systemd/system/multi-user.target.wants"
mkdir -p "$WANTS_DIR"

# Security services (ON by default)
for svc in ufw fail2ban apparmor clamav-freshclam auditd haveged; do
    SVC_FILE=""
    for dir in /lib/systemd/system /usr/lib/systemd/system; do
        if [ -f "$dir/${svc}.service" ]; then
            SVC_FILE="$dir/${svc}.service"
            break
        fi
    done
    if [ -n "$SVC_FILE" ]; then
        ln -sf "$SVC_FILE" "$WANTS_DIR/${svc}.service"
        echo "  Habilitado: ${svc}.service"
    else
        echo "  AVISO: ${svc}.service no encontrado, omitiendo."
    fi
done

# Optional security services (try to enable)
for svc in dnscrypt-proxy suricata usbguard unattended-upgrades acct; do
    SVC_FILE=""
    for dir in /lib/systemd/system /usr/lib/systemd/system; do
        if [ -f "$dir/${svc}.service" ]; then
            SVC_FILE="$dir/${svc}.service"
            break
        fi
    done
    if [ -n "$SVC_FILE" ]; then
        ln -sf "$SVC_FILE" "$WANTS_DIR/${svc}.service"
        echo "  Habilitado: ${svc}.service"
    fi
done

# ── 2. Disable Server Services (user activates as needed) ──
for svc in ssh nginx apache2 docker mariadb postgresql redis-server rabbitmq-server haproxy postfix dovecot bind9 kea-dhcp4-server; do
    rm -f "$WANTS_DIR/${svc}.service" 2>/dev/null || true
done
echo "  Servicios de servidor deshabilitados por defecto."

# ── 3. Configure SSH Hardening ────────────────────────────
if [ -f /etc/ssh/sshd_config ]; then
    echo "Aplicando hardening SSH..."

    # Create drop-in config for NexOS
    mkdir -p /etc/ssh/sshd_config.d
    cat <<EOF > /etc/ssh/sshd_config.d/nexos.conf
# NexOS SSH Hardening
Port 2222
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication yes
X11Forwarding no
MaxAuthTries 3
ClientAliveInterval 300
ClientAliveCountMax 2
AllowAgentForwarding no
AllowTcpForwarding no
Banner /etc/ssh/nexos-banner
Protocol 2
HostKeyAlgorithms ssh-ed25519,ssh-rsa
KexAlgorithms curve25519-sha256,diffie-hellman-group-exchange-sha256
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
EOF
    chmod 600 /etc/ssh/sshd_config.d/nexos.conf
fi

# ── 4. Configure UFW Rules ───────────────────────────────
echo "Pre-configurando reglas del firewall UFW..."
if command -v ufw &>/dev/null; then
    ufw default deny incoming 2>/dev/null || true
    ufw default allow outgoing 2>/dev/null || true
    ufw allow 2222/tcp comment 'NexOS SSH' 2>/dev/null || true
    ufw allow 80/tcp comment 'HTTP' 2>/dev/null || true
    ufw allow 443/tcp comment 'HTTPS' 2>/dev/null || true
    ufw limit 2222/tcp 2>/dev/null || true
    echo "ENABLED=yes" > /etc/ufw/ufw.conf
    echo "  Reglas UFW pre-configuradas."
fi

# ── 5. Create CLI Symlinks ───────────────────────────────
echo "Creando symlinks CLI de NexOS..."
ln -sf /opt/nexos/harden.sh /usr/local/bin/nexos-harden
ln -sf /opt/nexos/cleanup.sh /usr/local/bin/nexos-clean
ln -sf /opt/nexos/netmonitor.sh /usr/local/bin/nexos-netmon

# Ensure scripts are executable
chmod +x /opt/nexos/*.sh 2>/dev/null || true
chmod 700 /opt/nexos/ 2>/dev/null || true

echo "[NexOS] ✅ Configuración de servicios completada."
