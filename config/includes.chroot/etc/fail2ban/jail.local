# ============================================================
#  NexOS — Fail2ban Custom Configuration
#  /etc/fail2ban/jail.local
# ============================================================

[DEFAULT]
# Ban for 1 hour
bantime = 3600
# Find failures within 10 minutes
findtime = 600
# Allow 3 retries
maxretry = 3
# Use systemd journal
backend = systemd
# Email notifications (configure if needed)
# destemail = root@localhost
# sendername = NexOS-Fail2Ban
# action = %(action_mwl)s

[sshd]
enabled = true
port = 2222
maxretry = 3
bantime = 7200

[sshd-ddos]
enabled = true
port = 2222

[nginx-http-auth]
enabled = true
port = http,https

[nginx-botsearch]
enabled = true
port = http,https

[nginx-bad-request]
enabled = true
port = http,https

[apache-auth]
enabled = true
port = http,https

[apache-badbots]
enabled = true
port = http,https

[recidive]
enabled = true
logpath = /var/log/fail2ban.log
banaction = %(banaction_allports)s
bantime = 604800
findtime = 86400
maxretry = 5
